{
  "realm": "qui-est-ce",
  "enabled": true,
  "roles": {
    "realm": [
      {"name": "player", "description": "Can join and play games"},
      {
        "name": "admin",
        "description": "Can manage packs and cards",
        "composite": true,
        "composites": {"realm": ["player"]}
      }
    ]
  },
  "clients": [
    {
      "clientId": "qui-est-ce-back",
      "enabled": true,
      "publicClient": false,
      "secret": "dev-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": ["*"],
      "webOrigins": ["*"]
    },
    {
      "clientId": "qui-est-ce-front",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:4200/*"],
      "webOrigins": ["http://localhost:4200"],
      "protocolMappers": [
        {
          "name": "backend-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "qui-est-ce-back",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "player1",
      "enabled": true,
      "credentials": [{"type": "password", "value": "password", "temporary": false}],
      "realmRoles": ["player"]
    },
    {
      "username": "player2",
      "enabled": true,
      "credentials": [{"type": "password", "value": "password", "temporary": false}],
      "realmRoles": ["player"]
    },
    {
      "username": "admin",
      "enabled": true,
      "credentials": [{"type": "password", "value": "password", "temporary": false}],
      "realmRoles": ["admin"]
    },
    {
      "username": "service-account-qui-est-ce-back",
      "enabled": true,
      "serviceAccountClientId": "qui-est-ce-back",
      "clientRoles": {
        "realm-management": ["manage-users", "view-roles"]
      }
    }
  ]
}
