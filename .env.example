# Environment variables required when running in prod mode (QUARKUS_PROFILE=prod).
# Copy to .env, fill in real values, and never commit .env.

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=qui_est_ce
DB_USERNAME=qui_est_ce
DB_PASSWORD=change_me

# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change_me
# Public, https base URL the browser uses to load card images. The S3_ENDPOINT
# above is the internal Docker hostname; this one is the public Caddy site.
S3_PUBLIC_BASE_URL=https://s3.example.com

# Keycloak OIDC  (e.g. https://auth.example.com/realms/qui-est-ce)
OIDC_AUTH_SERVER_URL=https://auth.example.com/realms/qui-est-ce

# Secret of the `qui-est-ce-back` Keycloak client (token validation, resource server).
# Generate with: openssl rand -hex 32
# Must also be passed to the Keycloak container so realm-import substitution resolves it.
OIDC_CLIENT_SECRET=change_me

# Secret of the `qui-est-ce-admin` Keycloak client (machine-to-machine, holds
# realm-management/manage-users for POST /admin/users). MUST differ from OIDC_CLIENT_SECRET.
# Generate with: openssl rand -hex 32
KEYCLOAK_ADMIN_SECRET=change_me

# Keycloak admin base URL — no realm path (e.g. https://auth.example.com)
KEYCLOAK_URL=https://auth.example.com

# Comma-separated list of origins allowed to drive the API from a browser.
# In the current deploy the front is served at https://qui-est-qui.lepgu.fr
# and calls the back same-origin via Caddy path-routing, so CORS only matters
# for direct hits on api.<domain>. Change if a staging/preview origin or
# external admin host needs cross-origin access.
CORS_ALLOWED_ORIGINS=https://qui-est-qui.lepgu.fr
